{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/(.*\\.html)", "destination": "/public/$1" },
    { "source": "/account", "destination": "/public/account.html" },
    { "source": "/about", "destination": "/public/about.html" },
    { "source": "/download", "destination": "/public/download.html" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/forum", "destination": "/public/forum.html" },
    { "source": "/forum/post/(.*)", "destination": "/public/forum-post.html" },
    { "source": "/announcements", "destination": "/public/announcements.html" },
    { "source": "/profile", "destination": "/public/profile.html" }
  ],
  "functions": {
    "api/config.js": {
      "includeFiles": "api/data.json"
    },
    "api/contact.js": {
      "includeFiles": "api/data.json"
    },
    "api/contacts.js": {
      "includeFiles": "api/contacts.json"
    },
    "api/contacts/[id].js": {
      "includeFiles": "api/contacts.json"
    },
    "api/register.js": {
      "includeFiles": "data/users.json"
    },
    "api/auth.js": {
      "includeFiles": "data/users.json"
    },
    "api/me.js": {
      "includeFiles": "data/users.json"
    },
    "api/change-pwd.js": {
      "includeFiles": "data/users.json"
    },
    "api/logout.js": {
      "includeFiles": "data/users.json"
    },
    "api/update-profile.js": {
      "includeFiles": "data/users.json"
    },
    "api/posts.js": {
      "includeFiles": "data/posts.json"
    },
    "api/posts/[id].js": {
      "includeFiles": "data/posts.json"
    },
    "api/comments.js": {
      "includeFiles": "data/comments.json"
    },
    "api/likes.js": {
      "includeFiles": "data/likes.json"
    },
    "api/announcements.js": {
      "includeFiles": "data/announcements.json"
    },
    "api/follow.js": {
      "includeFiles": "data/users.json"
    },
    "api/profile.js": {
      "includeFiles": "data/users.json"
    },
    "api/friend.js": {
      "includeFiles": "data/users.json"
    }
  }
}
